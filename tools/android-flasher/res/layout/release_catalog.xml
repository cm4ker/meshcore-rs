<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="12dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/catalog_model" style="@style/SectionTitle" android:textSize="16sp" />
        <TextView android:id="@+id/catalog_context" style="@style/Body" android:layout_marginTop="4dp" />
        <RadioGroup android:id="@+id/catalog_roles"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:orientation="horizontal" android:visibility="gone">
            <RadioButton android:id="@+id/catalog_companion"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="Компаньон" android:textColor="@color/ink" />
            <RadioButton android:id="@+id/catalog_repeater"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="Репитер" android:textColor="@color/ink" />
        </RadioGroup>

        <LinearLayout android:id="@+id/catalog_recommended" style="@style/Panel"
            android:layout_marginTop="14dp" android:background="@drawable/recommended_release" android:visibility="gone">
            <TextView style="@style/FieldLabel" android:text="Рекомендуем" android:textColor="@color/accent" />
            <TextView android:id="@+id/catalog_version" style="@style/SectionTitle" android:textSize="18sp" />
            <TextView android:id="@+id/catalog_details" style="@style/Body" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/catalog_preview" style="@style/Body"
                android:layout_marginTop="2dp" android:text="Предварительный выпуск" android:textColor="@color/ink" />
            <Button android:id="@+id/catalog_download" style="@style/PrimaryAction"
                android:layout_marginTop="12dp" android:text="Скачать" />
        </LinearLayout>
        <TextView android:id="@+id/catalog_message" style="@style/Body"
            android:layout_marginTop="14dp" android:background="@drawable/field"
            android:padding="12dp" android:visibility="gone" />
        <Button android:id="@+id/catalog_more" style="@style/SoftAction"
            android:layout_marginTop="12dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/catalog_entries"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
